---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: Array<{
    image: ImageMetadata;
    altText: string;
    caption?: string;
  }>;
}

const { images } = Astro.props;
const menuWidths = [640, 960, 1280, 1920, 2560, 3508] as const;
---

<div class="menu-images">
  {
    images.map((item) => (
      <figure>
        <Image
          src={item.image}
          alt={item.altText}
          width={item.image.width}
          height={item.image.height}
          sizes="(min-width: 1000px) 70vw, 95vw"
          widths={[...menuWidths]}
        />
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .menu-images {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
  }

  figure {
    width: 95vw;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    padding: 0.75rem;
    color: #222;
    font-family: "Raleway", sans-serif;
    text-align: center;
  }

  @media (min-width: 1000px) {
    figure {
      width: 70vw;
    }
  }
</style>
