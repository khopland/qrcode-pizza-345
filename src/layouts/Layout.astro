---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  theme?: 'dark' | 'light';
}

const {
  title,
  description = 'Pizza 345 · Carta y menús',
  noindex = false,
  theme = 'dark',
} = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL;
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl) : undefined;
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} · Pizza 345</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Raleway, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #f8f3e8;
    --muted: #c7c0b2;
    --surface: #151514;
    --surface-raised: #232321;
    --accent: #efb23c;
    --accent-dark: #9d6810;
    --focus: #8ec5ff;
  }

  * { box-sizing: border-box; }

  html, body { min-height: 100%; margin: 0; }

  html { background: #0d0d0c; }

  html[data-theme="light"] {
    color-scheme: light;
    background: #eee9df;
  }

  body {
    background: var(--surface);
    color: var(--ink);
    line-height: 1.5;
  }

  a { color: inherit; }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
</style>
