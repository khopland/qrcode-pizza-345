# Public Astro build configuration (safe to expose)
PUBLIC_SANITY_PROJECT_ID=dlj2wldq
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-07-18
PUBLIC_SITE_URL=http://localhost:4321

# Server-only: Editor token used only by the local migration command
SANITY_API_WRITE_TOKEN=

# Sanity Studio (all SANITY_STUDIO_* variables are included in its browser bundle)
SANITY_STUDIO_PROJECT_ID=dlj2wldq
SANITY_STUDIO_DATASET=production

# Never store a Netlify build-hook URL here or in Sanity documents. Add it only
# in Sanity project webhook configuration as described in README.md.
